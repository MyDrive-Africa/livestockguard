# LivestockGuard Cloud Configuration
# Copy to .env and fill in production values

# PostgreSQL
POSTGRES_PASSWORD=livestockguard_dev

# JWT
JWT_SECRET=dev_secret_change_in_production

# Amazon SES (email alerts)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
SES_SENDER_EMAIL=alerts@livestockguard.co.za

# Alert recipients (comma-separated emails)
ALERT_EMAIL_RECIPIENTS=farmer@example.com

# Firebase Cloud Messaging (push notifications)
# Path to the service account JSON file
FIREBASE_CREDENTIALS_FILE=./config/firebase-credentials.json

# Webhook URLs (comma-separated, optional)
WEBHOOK_URLS=
